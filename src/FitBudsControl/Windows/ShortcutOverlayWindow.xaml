<Window
    x:Class="FitBudsControl.Windows.ShortcutOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="OverlayCard" CornerRadius="12" Background="#F21F1F1F">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>
            <StackPanel
                x:Name="ChoicesPanel"
                Margin="6,5"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6" />
            <Border
                x:Name="DescriptionPanel"
                Grid.Row="1"
                Background="#FF2C2C2C"
                CornerRadius="0,0,12,12">
                <TextBlock
                    x:Name="SelectedNameText"
                    FontSize="12"
                    Foreground="#DDF5F5F5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
