                                </Grid>

                                <Grid Grid.Row="6" RowSpacing="6" MinHeight="150">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="收到的数据" FontWeight="SemiBold" />
                                            <TextBlock x:Name="LegacyResponseStateText" Text="发送后会在这里持续显示耳机返回和主动发来的数据" FontSize="12" Opacity="0.68" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="复制所选" Click="CopySelectedLegacyResponses_Click" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="清空" Click="ClearLegacyResponses_Click" VerticalAlignment="Center" />
                                    </Grid>
                                    <ListView x:Name="LegacyResponseListView"
                                              Grid.Row="1"
                                              SelectionMode="Extended"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollMode="Enabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="25">
                                                    <Border Background="{Binding DirectionBackgroundBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DirectionLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding DirectionBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="12" Opacity="0.58" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Arrow}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{Binding DirectionBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding FrameText}" FontFamily="Consolas" FontSize="12" FontWeight="{Binding EmphasisWeight}" Foreground="{Binding DirectionBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="{Binding EmphasisWeight}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.82" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22,34,34" Spacing="14">
                            <TextBlock Text="关于" FontSize="28" FontWeight="SemiBold" />
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,4,0,0" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Image Width="52" Height="52" Source="ms-appx:///Assets/AppIcon.png" />
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="FitBuds Turbo 控制" FontSize="20" FontWeight="SemiBold" />
                                            <Button x:Name="VersionButton" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" Click="VersionButton_Click">
                                                <TextBlock x:Name="VersionTextBlock" Text="版本" Opacity="0.72" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="用于 Windows 的 FitBuds Turbo 控制工具，可查看电量、切换模式并管理耳机设置。" TextWrapping="Wrap" Opacity="0.78" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="许可证：GNU Affero General Public License v3.0" Opacity="0.68" />
                                </StackPanel>
                            </Border>
                    </StackPanel>
                </ScrollViewer>

                <InfoBar x:Name="SettingsInfoBar"
                         Width="420"
                         MaxWidth="420"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,24,24"
                         IsOpen="False"
                         IsClosable="True" />
                <ProgressRing x:Name="SettingsBusyRing" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,26,0" IsActive="False" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
