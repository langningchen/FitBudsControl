<Window
    x:Class="FitBudsControl.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Loaded="Root_Loaded" Background="Transparent">
        <NavigationView
            x:Name="Navigation"
            PaneTitle="FitBuds Turbo"
            Background="Transparent"
            IsSettingsVisible="False"
            PaneDisplayMode="Auto"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="Navigation_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="设备" Tag="device">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE702;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="声音与触控" Tag="sound">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="快捷键" Tag="shortcuts">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="应用" Tag="application">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="DeveloperNavigationItem" Content="开发者选项" Tag="developer" Visibility="Collapsed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="退出程序" Tag="exit">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8BB;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <ScrollViewer x:Name="DevicePanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22,34,34" Spacing="14">
                            <TextBlock Text="设备" FontSize="28" FontWeight="SemiBold" />

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,4,0,0" HorizontalAlignment="Stretch">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="96" Height="76" Source="ms-appx:///Assets/FitBudsTurbo.png" Stretch="Uniform" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock x:Name="DeviceNameValue" Text="FitBuds Turbo" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DeviceConnectionText" Text="未连接" Opacity="0.72" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Viewbox Width="16" Height="16"><PathIcon x:Name="DeviceLeftBatteryIcon" Width="24" Height="24" Data="F0 M 5.955 2.773 L 5.955 20.591 L 17.409 20.591 L 17.409 16.773 L 10.409 16.773 L 9.773 16.136 L 9.773 2.773 Z" Foreground="{ThemeResource TextFillColorPrimaryBrush}" /></Viewbox>
                                            <TextBlock Text="左" Opacity="0.68" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DeviceLeftBatteryValue" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <FontIcon x:Name="DeviceLeftLowBatteryStatusIcon" Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed" ToolTipService.ToolTip="电量不足" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Viewbox Width="16" Height="16"><PathIcon x:Name="DeviceRightBatteryIcon" Width="24" Height="24" Data="F0 M 5.824 2.735 L 5.824 20.647 L 8.912 20.647 L 8.912 13.853 L 9.529 13.235 L 11.382 13.235 L 12.000 13.853 L 12.000 14.471 L 13.235 16.324 L 13.235 17.559 L 14.471 19.412 L 14.471 20.647 L 18.176 20.647 L 18.176 20.029 L 17.559 19.412 L 17.559 18.176 L 16.941 17.559 L 16.941 16.941 L 16.324 16.324 L 16.324 15.088 L 15.706 14.471 L 15.706 13.235 L 17.559 11.382 L 17.559 10.765 L 18.176 10.147 L 18.176 5.824 L 17.559 5.206 L 17.559 4.588 L 16.324 3.353 L 15.706 3.353 L 15.088 2.735 Z M 8.912 6.441 L 9.529 5.824 L 13.235 5.824 L 15.088 7.676 L 15.088 8.294 L 13.235 10.147 L 9.529 10.147 L 8.912 9.529 Z" Foreground="{ThemeResource TextFillColorPrimaryBrush}" /></Viewbox>
                                            <TextBlock Text="右" Opacity="0.68" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DeviceRightBatteryValue" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <FontIcon x:Name="DeviceRightLowBatteryStatusIcon" Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed" ToolTipService.ToolTip="电量不足" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Viewbox Width="16" Height="16"><PathIcon x:Name="DeviceCaseBatteryIcon" Width="24" Height="24" Data="F0 M 3.056 10.056 L 3.056 15.111 L 3.444 15.111 L 3.833 15.500 L 4.222 16.667 L 5.000 17.444 L 5.000 17.833 L 5.389 18.222 L 5.778 18.222 L 6.556 19.000 L 6.944 19.000 L 8.111 19.778 L 17.056 19.778 L 17.444 19.389 L 18.611 19.000 L 19.389 18.222 L 19.778 18.222 L 21.333 15.889 L 21.333 10.444 L 20.944 10.444 L 20.556 10.833 L 19.389 10.833 L 19.000 11.222 L 6.556 11.222 L 6.167 10.833 L 5.000 10.833 L 3.833 10.056 Z M 3.833 7.722 L 3.833 8.889 L 4.222 9.278 L 5.000 9.278 L 5.389 9.667 L 6.556 9.667 L 6.944 10.056 L 18.611 10.056 L 19.000 9.667 L 20.167 9.667 L 20.556 9.278 L 20.944 9.278 L 21.333 8.889 L 21.333 7.722 L 20.944 7.333 L 20.944 6.944 L 20.167 6.167 L 20.167 5.778 L 19.778 5.389 L 19.389 5.389 L 18.611 4.611 L 18.222 4.611 L 17.833 4.222 L 17.444 4.222 L 17.056 3.833 L 8.111 3.833 L 7.722 4.222 L 7.333 4.222 L 6.944 4.611 L 6.556 4.611 L 5.778 5.389 L 5.389 5.389 L 5.000 5.778 L 5.000 6.167 L 4.222 6.944 L 4.222 7.333 Z" Foreground="{ThemeResource TextFillColorPrimaryBrush}" /></Viewbox>
                                            <TextBlock Text="盒" Opacity="0.68" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DeviceCaseBatteryValue" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                                <FontIcon x:Name="DeviceCaseLowBatteryStatusIcon" Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed" ToolTipService.ToolTip="电量不足" />
                                                <Viewbox x:Name="DeviceCaseChargingStatusIcon" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" ToolTipService.ToolTip="充电中">
                                                    <Canvas Width="12" Height="12"><Path Fill="{ThemeResource TextFillColorPrimaryBrush}" Data="M7.1,0.5 L2.8,6.2 H5.5 L4.4,11.5 L9.5,4.7 H6.7 Z" /></Canvas>
                                                </Viewbox>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="3" Content="刷新" Click="RefreshAll_Click" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="14" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="设备信息" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                            <Button x:Name="SaveDeviceNameButton" Grid.Column="1" Content="保存" HorizontalAlignment="Right" VerticalAlignment="Top" Click="SaveDeviceName_Click" />
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="设备名称" VerticalAlignment="Center" Opacity="0.72" />
                                            <TextBox x:Name="DeviceNameTextBox"
                                                     Grid.Column="1"
                                                     MaxLength="35"
                                                     AcceptsReturn="False"
                                                     TextWrapping="NoWrap"
                                                     PlaceholderText="输入新的设备名称" />
                                            <TextBlock Grid.Row="1" Text="固件版本" VerticalAlignment="Center" Opacity="0.72" />
                                            <TextBlock x:Name="FirmwareVersionValue" Grid.Row="1" Grid.Column="1" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="设备操作" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                        <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button Content="关机" HorizontalAlignment="Stretch" Click="PowerOffDevice_Click" />
                                            <Button Grid.Column="1" Content="断开连接" HorizontalAlignment="Stretch" Click="DisconnectDeviceCommand_Click" />
                                            <Button Grid.Row="1" Content="进入配对" HorizontalAlignment="Stretch" Click="EnterPairing_Click" />
                                            <Button Grid.Row="1" Grid.Column="1" Content="重置设备" HorizontalAlignment="Stretch" Click="ResetDevice_Click" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <Grid RowSpacing="12" HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="低电量提醒" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                            <TextBlock Text="达到设定电量时发送 Windows 通知" Opacity="0.68" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="LowBatteryNotificationsToggle"
                                                      Grid.Column="1"
                                                      MinWidth="0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Top"
                                                      Toggled="LowBatteryNotifications_Toggled" />
                                        <Button Grid.Column="2" Content="保存" HorizontalAlignment="Right" VerticalAlignment="Top" Click="SaveLowBattery_Click" />
                                    </Grid>
                                    <Grid x:Name="LowBatteryOptionsPanel" Grid.Row="1" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox x:Name="LeftLowBatteryNumberBox" Header="左耳（%）" Minimum="1" Maximum="100" SmallChange="5" SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="RightLowBatteryNumberBox" Grid.Column="1" Header="右耳（%）" Minimum="1" Maximum="100" SmallChange="5" SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="CaseLowBatteryNumberBox" Grid.Column="2" Header="耳机盒（%）" Minimum="1" Maximum="100" SmallChange="5" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="连接偏好" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                        <Button Grid.Column="1" Content="保存" HorizontalAlignment="Right" VerticalAlignment="Top" Click="SaveConnectionPreferences_Click" />
                                    </Grid>
                                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="打开快捷面板时自动连接" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="AutoConnectToggle" Grid.Column="1" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <NumberBox x:Name="ReconnectIntervalNumberBox"
                                               Header="断开后自动重连间隔（秒）"
                                               Minimum="1"
                                               Maximum="3600"
                                               SmallChange="1"
                                               SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="高级连接设置" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                        <Button Grid.Column="1" Content="保存" HorizontalAlignment="Right" VerticalAlignment="Top" Click="SaveConnection_Click" />
                                    </Grid>
                                    <Grid ColumnSpacing="12" RowSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBox x:Name="MacTextBox" Header="耳机地址" />
                                        <NumberBox x:Name="ChannelNumberBox" Grid.Column="1" Header="连接通道" Minimum="1" Maximum="30" SpinButtonPlacementMode="Compact" ToolTipService.ToolTip="通常保持默认值即可" />
                                        <NumberBox x:Name="ConnectTimeoutNumberBox" Grid.Row="1" Header="连接等待时间（毫秒）" Minimum="500" Maximum="10000" SmallChange="100" SpinButtonPlacementMode="Compact" ToolTipService.ToolTip="等待耳机建立连接的最长时间" />
                                        <NumberBox x:Name="TimeoutNumberBox" Grid.Row="1" Grid.Column="1" Header="状态响应时间（毫秒）" Minimum="100" Maximum="5000" SmallChange="50" SpinButtonPlacementMode="Compact" ToolTipService.ToolTip="等待耳机回应操作的最长时间" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SoundPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22,34,34" Spacing="14">
                            <TextBlock Text="声音与触控" FontSize="28" FontWeight="SemiBold" />

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,4,0,0" HorizontalAlignment="Stretch">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="提示音" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                        <Button Grid.Column="1" Content="保存" HorizontalAlignment="Right" VerticalAlignment="Top" Click="SavePrompt_Click" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleSwitch x:Name="PromptSwitch" MinWidth="0" VerticalAlignment="Center" Toggled="PromptSetting_Changed" />
                                        <Slider x:Name="PromptVolumeSlider" Grid.Column="1" Minimum="0" Maximum="15" StepFrequency="1" VerticalAlignment="Center" ValueChanged="PromptVolumeSlider_ValueChanged" ToolTipService.ToolTip="提示音音量" />
                                        <TextBlock x:Name="PromptVolumeText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="音质" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                        <Button x:Name="SaveSoundQualityButton" Grid.Column="1" Content="保存" HorizontalAlignment="Right" VerticalAlignment="Top" Click="SaveSoundQuality_Click" />
                                    </Grid>
                                    <ComboBox x:Name="SoundQualityComboBox" Grid.Row="1" HorizontalAlignment="Stretch" SelectionChanged="SoundQuality_SelectionChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="四段均衡器" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                        <Button x:Name="SaveEqualizerButton" Grid.Column="1" Content="保存" HorizontalAlignment="Right" VerticalAlignment="Top" Click="SaveEqualizer_Click" />
                                    </Grid>

                                    <Grid x:Name="EqualizerEditorGrid" ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="频段" FontWeight="SemiBold" Opacity="0.72" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="频率 (Hz)" FontWeight="SemiBold" Opacity="0.72" />
                                        <TextBlock Grid.Column="2" Text="增益 (dB)" FontWeight="SemiBold" Opacity="0.72" />
                                        <TextBlock Grid.Column="3" Text="Q 值" FontWeight="SemiBold" Opacity="0.72" />

                                        <TextBlock Grid.Row="1" Text="1" VerticalAlignment="Center" />
                                        <NumberBox x:Name="Eq0Frequency" Grid.Row="1" Grid.Column="1" Minimum="20" Maximum="200" SmallChange="1" SpinButtonPlacementMode="Compact" Value="100" ValueChanged="EqualizerSetting_Changed" />
                                        <NumberBox x:Name="Eq0Gain" Grid.Row="1" Grid.Column="2" Minimum="-3" Maximum="3" SmallChange="0.5" SpinButtonPlacementMode="Compact" Value="0" ValueChanged="EqualizerSetting_Changed" />
                                        <NumberBox x:Name="Eq0Q" Grid.Row="1" Grid.Column="3" Minimum="0.7" Maximum="2" SmallChange="0.1" SpinButtonPlacementMode="Compact" Value="0.7" ValueChanged="EqualizerSetting_Changed" />

                                        <TextBlock Grid.Row="2" Text="2" VerticalAlignment="Center" />
                                        <NumberBox x:Name="Eq1Frequency" Grid.Row="2" Grid.Column="1" Minimum="201" Maximum="2000" SmallChange="1" SpinButtonPlacementMode="Compact" Value="1000" ValueChanged="EqualizerSetting_Changed" />
                                        <NumberBox x:Name="Eq1Gain" Grid.Row="2" Grid.Column="2" Minimum="-3" Maximum="3" SmallChange="0.5" SpinButtonPlacementMode="Compact" Value="0" ValueChanged="EqualizerSetting_Changed" />
                                        <NumberBox x:Name="Eq1Q" Grid.Row="2" Grid.Column="3" Minimum="0.7" Maximum="2" SmallChange="0.1" SpinButtonPlacementMode="Compact" Value="0.7" ValueChanged="EqualizerSetting_Changed" />

                                        <TextBlock Grid.Row="3" Text="3" VerticalAlignment="Center" />
                                        <NumberBox x:Name="Eq2Frequency" Grid.Row="3" Grid.Column="1" Minimum="2001" Maximum="4000" SmallChange="1" SpinButtonPlacementMode="Compact" Value="3000" ValueChanged="EqualizerSetting_Changed" />
                                        <NumberBox x:Name="Eq2Gain" Grid.Row="3" Grid.Column="2" Minimum="-3" Maximum="3" SmallChange="0.5" SpinButtonPlacementMode="Compact" Value="0" ValueChanged="EqualizerSetting_Changed" />
                                        <NumberBox x:Name="Eq2Q" Grid.Row="3" Grid.Column="3" Minimum="0.7" Maximum="2" SmallChange="0.1" SpinButtonPlacementMode="Compact" Value="0.7" ValueChanged="EqualizerSetting_Changed" />

                                        <TextBlock Grid.Row="4" Text="4" VerticalAlignment="Center" />
                                        <NumberBox x:Name="Eq3Frequency" Grid.Row="4" Grid.Column="1" Minimum="4001" Maximum="8000" SmallChange="1" SpinButtonPlacementMode="Compact" Value="5000" ValueChanged="EqualizerSetting_Changed" />
                                        <NumberBox x:Name="Eq3Gain" Grid.Row="4" Grid.Column="2" Minimum="-3" Maximum="3" SmallChange="0.5" SpinButtonPlacementMode="Compact" Value="0" ValueChanged="EqualizerSetting_Changed" />
                                        <NumberBox x:Name="Eq3Q" Grid.Row="4" Grid.Column="3" Minimum="0.7" Maximum="2" SmallChange="0.1" SpinButtonPlacementMode="Compact" Value="0.7" ValueChanged="EqualizerSetting_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="定时关闭" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                        <Button Grid.Column="1" Content="保存" HorizontalAlignment="Right" VerticalAlignment="Top" Click="SaveTimer_Click" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <ToggleSwitch x:Name="TimerSwitch" MinWidth="0" VerticalAlignment="Center" Toggled="TimerSwitch_Toggled" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <NumberBox x:Name="TimerNumberBox" Width="120" Minimum="1" Maximum="90" SmallChange="1" SpinButtonPlacementMode="Compact" Value="30" />
                                            <TextBlock Text="分钟" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="触控操作" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                        <Button Grid.Column="1" Content="保存" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ApplyTouch_Click" />
                                    </Grid>
                                    <Grid ColumnSpacing="22">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="左耳" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="双击" Opacity="0.72" /><ComboBox x:Name="Touch01" Tag="01" SelectionChanged="TouchSelection_Changed" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="三击" Opacity="0.72" /><ComboBox x:Name="Touch03" Tag="03" SelectionChanged="TouchSelection_Changed" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="长按" Opacity="0.72" /><ComboBox x:Name="Touch08" Tag="08" SelectionChanged="TouchSelection_Changed" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="右耳" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="双击" Opacity="0.72" /><ComboBox x:Name="Touch02" Tag="02" SelectionChanged="TouchSelection_Changed" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="三击" Opacity="0.72" /><ComboBox x:Name="Touch04" Tag="04" SelectionChanged="TouchSelection_Changed" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="长按" Opacity="0.72" /><ComboBox x:Name="Touch09" Tag="09" SelectionChanged="TouchSelection_Changed" HorizontalAlignment="Stretch" />
