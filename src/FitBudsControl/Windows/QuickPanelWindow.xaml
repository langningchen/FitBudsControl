<Window
    x:Class="FitBudsControl.Windows.QuickPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Grid x:Name="RootGrid" Padding="18,16,18,14" RowSpacing="12" Background="Transparent">
        <Grid.Resources>
        <Style x:Key="QuickTileButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="54" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="QuickTileLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: intentionally compact like Windows 11 Quick Settings. -->
        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="64" Height="44">
                <Image Width="60" Height="42" Source="ms-appx:///Assets/FitBudsTurbo.png" Stretch="Uniform" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="DeviceNameText" Text="FitBuds Turbo" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ConnectionText" Text="未连接" FontSize="12" Opacity="0.70" />
            </StackPanel>

            <Button x:Name="RefreshButton"
                    Grid.Column="2"
                    Click="Refresh_Click"
                    ToolTipService.ToolTip="刷新状态"
                    Width="36"
                    Height="36"
                    Padding="0"
                    CornerRadius="8">
                <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Battery strip. -->
        <Border x:Name="BatteryCard" Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14,12">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="18" Height="18">

                            <PathIcon x:Name="LeftBatteryIcon" Width="24" Height="24" Data="F0 M 5.955 2.773 L 5.955 20.591 L 17.409 20.591 L 17.409 16.773 L 10.409 16.773 L 9.773 16.136 L 9.773 2.773 Z" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        </Viewbox>
                        <TextBlock Text="左耳" FontSize="12" Opacity="0.68" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LeftBatteryText" Text="—" FontSize="20" FontWeight="SemiBold" />
                        <FontIcon x:Name="LeftLowBatteryStatusIcon"
                                  Grid.Column="1"
                                  Glyph="&#xE7BA;"
                                  FontSize="15"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                  Visibility="Collapsed"
                                  ToolTipService.ToolTip="电量不足" />
                    </Grid>
                    <ProgressBar x:Name="LeftBatteryBar" Minimum="0" Maximum="100" Height="3" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="18" Height="18">

                            <PathIcon x:Name="RightBatteryIcon" Width="24" Height="24" Data="F0 M 5.824 2.735 L 5.824 20.647 L 8.912 20.647 L 8.912 13.853 L 9.529 13.235 L 11.382 13.235 L 12.000 13.853 L 12.000 14.471 L 13.235 16.324 L 13.235 17.559 L 14.471 19.412 L 14.471 20.647 L 18.176 20.647 L 18.176 20.029 L 17.559 19.412 L 17.559 18.176 L 16.941 17.559 L 16.941 16.941 L 16.324 16.324 L 16.324 15.088 L 15.706 14.471 L 15.706 13.235 L 17.559 11.382 L 17.559 10.765 L 18.176 10.147 L 18.176 5.824 L 17.559 5.206 L 17.559 4.588 L 16.324 3.353 L 15.706 3.353 L 15.088 2.735 Z M 8.912 6.441 L 9.529 5.824 L 13.235 5.824 L 15.088 7.676 L 15.088 8.294 L 13.235 10.147 L 9.529 10.147 L 8.912 9.529 Z" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        </Viewbox>
                        <TextBlock Text="右耳" FontSize="12" Opacity="0.68" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RightBatteryText" Text="—" FontSize="20" FontWeight="SemiBold" />
                        <FontIcon x:Name="RightLowBatteryStatusIcon"
                                  Grid.Column="1"
                                  Glyph="&#xE7BA;"
                                  FontSize="15"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                  Visibility="Collapsed"
                                  ToolTipService.ToolTip="电量不足" />
                    </Grid>
                    <ProgressBar x:Name="RightBatteryBar" Minimum="0" Maximum="100" Height="3" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="18" Height="18">

                            <PathIcon x:Name="CaseBatteryIcon" Width="24" Height="24" Data="F0 M 3.056 10.056 L 3.056 15.111 L 3.444 15.111 L 3.833 15.500 L 4.222 16.667 L 5.000 17.444 L 5.000 17.833 L 5.389 18.222 L 5.778 18.222 L 6.556 19.000 L 6.944 19.000 L 8.111 19.778 L 17.056 19.778 L 17.444 19.389 L 18.611 19.000 L 19.389 18.222 L 19.778 18.222 L 21.333 15.889 L 21.333 10.444 L 20.944 10.444 L 20.556 10.833 L 19.389 10.833 L 19.000 11.222 L 6.556 11.222 L 6.167 10.833 L 5.000 10.833 L 3.833 10.056 Z M 3.833 7.722 L 3.833 8.889 L 4.222 9.278 L 5.000 9.278 L 5.389 9.667 L 6.556 9.667 L 6.944 10.056 L 18.611 10.056 L 19.000 9.667 L 20.167 9.667 L 20.556 9.278 L 20.944 9.278 L 21.333 8.889 L 21.333 7.722 L 20.944 7.333 L 20.944 6.944 L 20.167 6.167 L 20.167 5.778 L 19.778 5.389 L 19.389 5.389 L 18.611 4.611 L 18.222 4.611 L 17.833 4.222 L 17.444 4.222 L 17.056 3.833 L 8.111 3.833 L 7.722 4.222 L 7.333 4.222 L 6.944 4.611 L 6.556 4.611 L 5.778 5.389 L 5.389 5.389 L 5.000 5.778 L 5.000 6.167 L 4.222 6.944 L 4.222 7.333 Z" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        </Viewbox>
                        <TextBlock Text="耳机盒" FontSize="12" Opacity="0.68" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CaseBatteryText" Text="—" FontSize="20" FontWeight="SemiBold" />
                        <Grid Grid.Column="1" Width="18" Height="20" VerticalAlignment="Center">
                            <FontIcon x:Name="CaseLowBatteryStatusIcon"
                                      Glyph="&#xE7BA;"
                                      FontSize="15"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      Visibility="Collapsed"
                                      ToolTipService.ToolTip="电量不足" />
                            <Viewbox x:Name="CaseChargingStatusIcon"
                                     Width="14" Height="14"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="Collapsed"
                                     ToolTipService.ToolTip="充电中">
                                <Canvas Width="12" Height="12">
                                    <Path Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                          Data="M7.1,0.5 L2.8,6.2 H5.5 L4.4,11.5 L9.5,4.7 H6.7 Z" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Grid>
                    <ProgressBar x:Name="CaseBatteryBar" Minimum="0" Maximum="100" Height="3" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ANC tiles. Checked ToggleButtons inherit the Windows accent color. -->
        <Border x:Name="NoisePanel" Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14,12">
            <StackPanel Spacing="7">
            <TextBlock Text="降噪" FontSize="13" FontWeight="SemiBold" />
            <Grid ColumnSpacing="7" RowSpacing="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <ToggleButton x:Name="DeepButton" Tag="Deep" Click="NoiseButton_Click" Style="{StaticResource QuickTileButtonStyle}">
                        <Viewbox Width="30" Height="30">

                            <PathIcon x:Name="DeepIcon" Width="24" Height="24" Data="{StaticResource DeepModeIconGeometry}" Foreground="#FFF3F3F3" />

                        </Viewbox>
                    </ToggleButton>
                    <TextBlock Text="深度" Style="{StaticResource QuickTileLabelStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                    <ToggleButton x:Name="ComfortButton" Tag="Comfort" Click="NoiseButton_Click" Style="{StaticResource QuickTileButtonStyle}">
                        <Viewbox Width="30" Height="30">

                            <PathIcon x:Name="ComfortIcon" Width="24" Height="24" Data="{StaticResource ComfortModeIconGeometry}" Foreground="#FFF3F3F3" />

                        </Viewbox>
                    </ToggleButton>
                    <TextBlock Text="舒适" Style="{StaticResource QuickTileLabelStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                    <ToggleButton x:Name="AmbientButton" Tag="Ambient" Click="NoiseButton_Click" Style="{StaticResource QuickTileButtonStyle}">
                        <Viewbox Width="30" Height="30">

                            <PathIcon x:Name="AmbientIcon" Width="24" Height="24" Data="{StaticResource AmbientModeIconGeometry}" Foreground="#FFF3F3F3" />

                        </Viewbox>
                    </ToggleButton>
                    <TextBlock Text="环境音" Style="{StaticResource QuickTileLabelStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                    <ToggleButton x:Name="WideButton" Tag="Wide" Click="NoiseButton_Click" Style="{StaticResource QuickTileButtonStyle}">
                        <Viewbox Width="30" Height="30">

                            <PathIcon x:Name="WideIcon" Width="24" Height="24" Data="{StaticResource WideModeIconGeometry}" Foreground="#FFF3F3F3" />

                        </Viewbox>
                    </ToggleButton>
                    <TextBlock Text="宽频" Style="{StaticResource QuickTileLabelStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <ToggleButton x:Name="WindButton" Tag="Wind" Click="NoiseButton_Click" Style="{StaticResource QuickTileButtonStyle}">
                        <Viewbox Width="30" Height="30">

                            <PathIcon x:Name="WindIcon" Width="24" Height="24" Data="{StaticResource WindModeIconGeometry}" Foreground="#FFF3F3F3" />

                        </Viewbox>
                    </ToggleButton>
                    <TextBlock Text="防风" Style="{StaticResource QuickTileLabelStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                    <ToggleButton x:Name="OffButton" Tag="Off" Click="NoiseButton_Click" Style="{StaticResource QuickTileButtonStyle}">
                        <Viewbox Width="30" Height="30">

                            <PathIcon x:Name="OffIcon" Width="24" Height="24" Data="{StaticResource OffModeIconGeometry}" Foreground="#FFF3F3F3" />

                        </Viewbox>
                    </ToggleButton>
                    <TextBlock Text="关闭" Style="{StaticResource QuickTileLabelStyle}" />
                </StackPanel>
            </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="AmbientCard" Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="14,10">
            <StackPanel Spacing="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="环境音级别" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="AmbientValueText" Grid.Column="1" Text="—" Opacity="0.72" />
                </Grid>
                <Slider x:Name="AmbientSlider" Minimum="-3" Maximum="3" StepFrequency="1" ValueChanged="AmbientSlider_ValueChanged" />
            </StackPanel>
        </Border>

        <!-- Scene tiles. -->
        <Border x:Name="ScenePanel" Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="14,12">
            <StackPanel Spacing="7">
            <TextBlock Text="声音场景" FontSize="13" FontWeight="SemiBold" />
            <Grid ColumnSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <ToggleButton x:Name="MusicButton" Tag="Music" Click="SceneButton_Click" Style="{StaticResource QuickTileButtonStyle}">
                        <Viewbox Width="30" Height="30">

                            <PathIcon x:Name="MusicIcon" Width="24" Height="24" Data="{StaticResource MusicModeIconGeometry}" Foreground="#FFF3F3F3" />

                        </Viewbox>
                    </ToggleButton>
                    <TextBlock Text="音乐" Style="{StaticResource QuickTileLabelStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <ToggleButton x:Name="GameButton" Tag="Game" Click="SceneButton_Click" Style="{StaticResource QuickTileButtonStyle}">
                        <Viewbox Width="30" Height="30">

                            <PathIcon x:Name="GameIcon" Width="24" Height="24" Data="{StaticResource GameModeIconGeometry}" Foreground="#FFF3F3F3" />

                        </Viewbox>
                    </ToggleButton>
                    <TextBlock Text="游戏" Style="{StaticResource QuickTileLabelStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <ToggleButton x:Name="SpatialButton" Tag="Spatial" Click="SceneButton_Click" Style="{StaticResource QuickTileButtonStyle}">
                        <Viewbox Width="30" Height="30">

                            <PathIcon x:Name="SpatialIcon" Width="24" Height="24" Data="{StaticResource SpatialModeIconGeometry}" Foreground="#FFF3F3F3" />

                        </Viewbox>
                    </ToggleButton>
                    <TextBlock Text="空间音效" Style="{StaticResource QuickTileLabelStyle}" />
                </StackPanel>
            </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="5" Margin="0,2,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="未连接" FontSize="12" Opacity="0.66" TextWrapping="Wrap" VerticalAlignment="Center" />
            <ProgressRing x:Name="BusyRing" Grid.Column="1" Width="20" Height="20" IsActive="False" />
            <Button Grid.Column="2"
                    Click="Settings_Click"
                    ToolTipService.ToolTip="打开设置"
                    Width="36"
                    Height="36"
                    Padding="0"
                    CornerRadius="8">
                <FontIcon Glyph="&#xE713;" FontSize="17" />
            </Button>
        </Grid>
    </Grid>
</Window>
